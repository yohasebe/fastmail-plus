{
  "manifest_version": 3,
  "name": "Fastmail Plus",
  "default_locale": "en",
  "version": "0.6.0",
  "description": "Makes the Fastmail web UI easier to use and more productive.",
  "icons": {
    "16": "images/fastmail-plus-16.png",
    "48": "images/fastmail-plus-48.png",
    "128": "images/fastmail-plus-128.png"
  },
  "action": {
    "default_icon": "images/fastmail-plus-128.png",
    "default_popup": "options.html"
  },
  "minimum_chrome_version": "111",
  "content_scripts": [
    {
      "matches": ["https://*.fastmail.com/*"],
      "js": ["content/fastmail_prefs.js"],
      "world": "MAIN"
    },
    {
      "matches": ["https://*.fastmail.com/*"],
      "js": [
        "content/selectors.js",
        "content/setup.js",
        "content/move_focus.js",
        "content/search_fix.js",
        "content/alternative_search.js",
        "content/layout_toggle.js",
        "content/reading_pane_control.js",
        "content/extra_shortcuts.js",
        "content/maximize_message_width.js",
        "content/main.js"
      ],
      "css": [
        "content/main.css"
      ]
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "permissions": ["storage"]
}
